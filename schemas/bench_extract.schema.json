{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bench_extract",
  "type": "object",
  "properties": {
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cite": {"type": "string"},
          "quote": {"type": "string"},
          "text": {"type": "string"}
        },
        "required": ["cite", "quote", "text"],
        "additionalProperties": false
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {"type": "string", "enum": ["conflict", "gap"]},
          "cites": {"type": "array", "items": {"type": "string"}},
          "about": {"type": "string"}
        },
        "required": ["kind", "cites", "about"],
        "additionalProperties": false
      }
    }
  },
  "required": ["facts", "flags"],
  "additionalProperties": false
}
