{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "factsheet",
  "type": "object",
  "properties": {
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cite": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "use": {
            "type": "string",
            "enum": [
              "our_case",
              "defense_case",
              "both",
              "danger",
              "none"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "cite",
          "quote",
          "use",
          "note"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "facts"
  ],
  "additionalProperties": false
}
