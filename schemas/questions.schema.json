{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "questions",
  "type": "object",
  "properties": {
    "section": {
      "type": "string",
      "enum": [
        "primary",
        "cross",
        "redirect"
      ]
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "cite": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "text",
          "cite",
          "quote",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "points_for_our_expert": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "cite": {
            "type": "string"
          }
        },
        "required": [
          "text",
          "quote",
          "cite"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "section",
    "questions",
    "points_for_our_expert"
  ],
  "additionalProperties": false
}
