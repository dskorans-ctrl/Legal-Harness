                "quote": {
                  "type": "string"
                },
                "cite": {
                  "type": "string"
                }
              },
              "required": [
                "quote",
                "cite"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "label",
          "quote",
          "cite",
          "supporting_findings"
        ],
        "additionalProperties": false
      }
    },
    "danger_zone": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "quote": {
            "type": "string"
          },
          "cite": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        },
        "required": [
          "quote",
          "cite",
          "why"
        ],
        "additionalProperties": false
      }
