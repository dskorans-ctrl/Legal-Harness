{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "concessions",
  "type": "object",
  "properties": {
    "concessions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "causally_related_diagnosis",
              "treatment_reasonable",
              "bills_reasonable",
              "impairment_rating",
              "restrictions",
              "recommended_treatment",
              "positive_finding",
              "consistent_or_credible",
              "other"
            ]
          },
          "quote": {
            "type": "string"
          },
          "cite": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "quote",
          "cite"
        ],
        "additionalProperties": false
      }
    },
    "undefined_labels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "cite": {
            "type": "string"
          },
          "supporting_findings": {
            "type": "array",
